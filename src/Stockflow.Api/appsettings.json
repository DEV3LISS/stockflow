{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "stockflow",
    "Audience": "stockflow-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Payments": {
    "WebhookSecret": "",
    "PublicBaseUrl": "http://localhost:8080",
    "SignatureToleranceSeconds": 300
  },
  "PaymentSimulator": {
    "Enabled": false
  },
  "Inventory": {
    "ReservationStrategy": "Atomic"
  },
  "Expiry": {
    "Enabled": true,
    "IntervalSeconds": 10
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 5
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
